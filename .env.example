# ============================================
# SIP Discovery Engine — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here

# --- Reddit API (OAuth2 via PRAW) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=sip-discovery-engine/0.1 by YourRedditUsername

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Database ---
# Path to SQLite database file (relative to project root)
DATABASE_PATH=data/sip_discovery.db

# --- ChromaDB ---
# Path to ChromaDB persistent storage directory
CHROMADB_PATH=data/chromadb

# --- Logging ---
LOG_LEVEL=INFO
