{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sip-discovery-engine-api.onrender.com/api/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/src/ui/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/src/ui/js/:path*"
    },
    {
      "source": "/",
      "destination": "/src/ui/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/src/ui/:path*"
    }
  ]
}

